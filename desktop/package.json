{
  "name": "vodoo-music-desktop",
  "version": "1.0.0",
  "description": "Vodoo Music - Premium Luxury Music Streaming for Windows & macOS",
  "main": "dist/main/main.js",
  "author": "Miraç Teksaslıoğlu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrcbrbn5361/VodooMusic.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json && electron .",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build:installer": "npm run build && electron-builder --win nsis --publish never",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:portable": "npm run build && electron-builder --win portable --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.main.json"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "electron": "28.3.3",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  },
  "build": {
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "mrcbrbn5361",
        "repo": "VodooMusic"
      }
    ],
    "appId": "com.vodoo.music",
    "productName": "Vodoo Music",
    "copyright": "Copyright © 2026 Vodoo Music",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vodoo Music",
      "artifactName": "Vodoo-Music-Setup-${version}-win-x64.${ext}",
      "installerLanguages": [
        "tr_TR",
        "en_US"
      ],
      "multiLanguageInstaller": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "uninstallDisplayName": "Vodoo Music",
      "installerSidebar": "assets/installerSidebar.bmp",
      "uninstallerSidebar": "assets/uninstallerSidebar.bmp",
      "installerHeader": "assets/installerHeader.bmp",
      "installerHeaderIcon": "assets/icon.ico",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "Vodoo-Music-Portable-${version}-win-x64.${ext}",
      "requestExecutionLevel": "user"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.music",
      "artifactName": "Vodoo-Music-${version}-mac-universal.${ext}",
      "minimumSystemVersion": "10.15.0",
      "hardenedRuntime": false,
      "identity": null,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Vodoo-Music-${version}-mac-universal.${ext}",
      "title": "Vodoo Music",
      "contents": [
        {
          "x": 140,
          "y": 200
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
